# One literal string per line; the secret scanner drops matches that equal any line below.
# Template/fixture strings from spec docs, README, and test files — not real secrets.
`{"AIza" + random 15-char suffix, "postgres://u:REAL_SECRET@h/d",
        env={"DATABASE_URL": "postgresql://nope:nope@127.0.0.1:1/nope"},
        "GEMINI_API_KEY=AIza1234567890abcdefghij\n",
        "DATABASE_URL=postgresql://admin:s3cr3tP@ssw0rd@db:5432/prod\n",
        content_parts.append("AIza1234567890abcdefghij")
        content_parts.append("postgresql://admin:RealSecret123@db:5432/prod")
