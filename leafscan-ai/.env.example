# API URL for Expo app.
# "auto" infers http://<expo-lan-host>:8000 when using `expo start --host lan`.
EXPO_PUBLIC_API_BASE_URL=auto

# ── Google OAuth Client IDs ──
# Tạo tại: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Emails được hiển thị màn hình admin trong app, phải khớp backend ADMIN_EMAILS.
EXPO_PUBLIC_ADMIN_EMAILS=admin@example.com
