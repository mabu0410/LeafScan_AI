# API URL for Expo app.
# "auto" infers http://<expo-lan-host>:8000 when using `expo start --host lan`.
# Set EXPO_PUBLIC_API_DOMAIN to one domain, e.g. local LAN or ngrok.
EXPO_PUBLIC_API_DOMAIN=
EXPO_PUBLIC_API_BASE_URL=auto

# Expo/EAS project id is required for Android push notifications in a development/production build.
# Lấy bằng: npx eas project:info
EXPO_PUBLIC_EAS_PROJECT_ID=

# ── Google OAuth Client IDs ──
# Tạo tại: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Emails được hiển thị màn hình admin trong app, phải khớp backend ADMIN_EMAILS.
EXPO_PUBLIC_ADMIN_EMAILS=admin@example.com
